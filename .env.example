# ZP Pics — copie para .env.local e preencha.
# Só nomes aqui, nunca valores. Manter esta lista completa e atualizada.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Ignora RLS. Só no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (bucket PRIVADO) -----------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Sessão do cliente ------------------------------------------------------
# Segredo de assinatura do cookie da galeria. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSAO_COOKIE_SECRET=

# --- E-mail de aviso quando o cliente finaliza ------------------------------
RESEND_API_KEY=
# Remetente. Precisa ser de um domínio verificado no Resend.
EMAIL_FROM=
# Quem recebe o aviso na ZP.
EMAIL_TO=

# --- Geral ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Limpeza diária (cron da Vercel) ----------------------------------------
# Protege /api/cron/limpeza: apaga do bucket as tratadas cujo prazo de entrega
# venceu e mantém o Supabase acordado. A Vercel manda o segredo sozinha. Gere:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
